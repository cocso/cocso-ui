/* cocso brand theme. Import after token.css and theme-dark.css; set
 * data-brand="cocso" on the container that carries data-theme. */
[data-brand="cocso"] {
  --cocso-color-primary-50: var(--cocso-color-info-50);
  --cocso-color-primary-100: var(--cocso-color-info-100);
  --cocso-color-primary-200: var(--cocso-color-info-200);
  --cocso-color-primary-300: var(--cocso-color-info-300);
  --cocso-color-primary-400: var(--cocso-color-info-400);
  --cocso-color-primary-500: var(--cocso-color-info-500);
  --cocso-color-primary-600: var(--cocso-color-info-600);
  --cocso-color-primary-700: var(--cocso-color-info-700);
  --cocso-color-primary-800: var(--cocso-color-info-800);
  --cocso-color-primary-900: var(--cocso-color-info-900);
  --cocso-color-primary-950: var(--cocso-color-info-950);
  --cocso-color-interactive-primary: var(--cocso-color-info-500);
  --cocso-color-interactive-primary-hover: var(--cocso-color-info-600);
  --cocso-color-interactive-primary-active: var(--cocso-color-info-700);
  --cocso-color-interactive-primary-muted: var(--cocso-color-info-200);
  --cocso-color-text-on-primary: var(--cocso-color-white);
  --cocso-color-surface-primary: var(--cocso-color-white);
  --cocso-color-surface-secondary: var(--cocso-color-neutral-50);
  --cocso-color-border-secondary: var(--cocso-color-neutral-100);
  --cocso-color-feedback-danger-subtle: var(--cocso-color-danger-50);
  --cocso-color-feedback-success-subtle: var(--cocso-color-success-50);
  --cocso-color-feedback-warning-subtle: var(--cocso-color-warning-50);
  --cocso-color-feedback-info-subtle: var(--cocso-color-info-50);
  --cocso-color-feedback-danger-border: var(--cocso-color-danger-200);
  --cocso-color-feedback-success-border: var(--cocso-color-success-200);
  --cocso-color-feedback-warning-border: var(--cocso-color-warning-200);
  --cocso-color-feedback-info-border: var(--cocso-color-info-200);
  --cocso-color-feedback-warning-text: var(--cocso-color-warning-600);
}

[data-brand="cocso"][data-theme="dark"] {
  --cocso-color-primary-50: var(--cocso-color-info-50);
  --cocso-color-primary-100: var(--cocso-color-info-100);
  --cocso-color-primary-200: var(--cocso-color-info-200);
  --cocso-color-primary-300: var(--cocso-color-info-300);
  --cocso-color-primary-400: var(--cocso-color-info-400);
  --cocso-color-primary-500: var(--cocso-color-info-500);
  --cocso-color-primary-600: var(--cocso-color-info-600);
  --cocso-color-primary-700: var(--cocso-color-info-700);
  --cocso-color-primary-800: var(--cocso-color-info-800);
  --cocso-color-primary-900: var(--cocso-color-info-900);
  --cocso-color-primary-950: var(--cocso-color-info-950);
  --cocso-color-interactive-primary: #2260d3;
  --cocso-color-interactive-primary-hover: var(--cocso-color-info-600);
  --cocso-color-interactive-primary-active: var(--cocso-color-info-700);
  --cocso-color-interactive-primary-muted: #1e2a45;
  --cocso-color-text-on-primary: var(--cocso-color-white);
  --cocso-color-surface-primary: #1a1d21;
  --cocso-color-surface-secondary: #24282d;
  --cocso-color-border-secondary: #3a3e46;
  --cocso-color-feedback-danger-subtle: #493231;
  --cocso-color-feedback-success-subtle: #293f34;
  --cocso-color-feedback-warning-subtle: #413925;
  --cocso-color-feedback-info-subtle: #2b3951;
  --cocso-color-feedback-danger-border: var(--cocso-color-danger-500);
  --cocso-color-feedback-success-border: var(--cocso-color-success-500);
  --cocso-color-feedback-warning-border: var(--cocso-color-warning-500);
  --cocso-color-feedback-info-border: var(--cocso-color-info-500);
  --cocso-color-feedback-warning-text: #e49410;
}
