/**
 * Opt-in dark theme for @cocso-ui. GENERATED — edit
 * `packages/baseframe-sources/semantic/color.yaml` and run
 * `pnpm --filter @cocso-ui/baseframe generate:css`.
 *
 * Import AFTER `token.css` and set `data-theme="dark"` on a container:
 *
 *   import "@cocso-ui/css/token.css";
 *   import "@cocso-ui/css/theme-dark.css";
 *
 *   <html data-theme="dark"> … </html>
 *
 * Only the semantic layer is here. The raw ramps stay in `token.css` and are
 * not repeated, so an app that overrides `--cocso-color-primary-*` keeps that
 * override in both themes. Every semantic token declares a dark value in the
 * source, including the ones that deliberately do not move — the reasoning for
 * each is in the YAML next to the value.
 */
[data-theme="dark"] {
  --cocso-color-alpha-shadow1: rgba(0, 0, 0, 0.24);
  --cocso-color-alpha-shadow2: rgba(0, 0, 0, 0.36);
  --cocso-color-alpha-shadow3: rgba(0, 0, 0, 0.48);
  --cocso-color-transparent: transparent;
  --cocso-color-text-primary: var(--cocso-color-neutral-50);
  --cocso-color-text-secondary: var(--cocso-color-neutral-400);
  --cocso-color-text-tertiary: var(--cocso-color-neutral-500);
  --cocso-color-text-disabled: var(--cocso-color-neutral-600);
  --cocso-color-text-on-primary: var(--cocso-color-neutral-950);
  --cocso-color-text-on-success: var(--cocso-color-white);
  --cocso-color-text-on-danger: var(--cocso-color-white);
  --cocso-color-text-on-info: var(--cocso-color-white);
  --cocso-color-text-on-warning: var(--cocso-color-neutral-950);
  --cocso-color-text-muted: var(--cocso-color-neutral-500);
  --cocso-color-surface-primary: var(--cocso-color-neutral-950);
  --cocso-color-surface-secondary: var(--cocso-color-neutral-900);
  --cocso-color-surface-inverse: var(--cocso-color-white);
  --cocso-color-surface-neutral: var(--cocso-color-neutral-800);
  --cocso-color-border-primary: var(--cocso-color-neutral-700);
  --cocso-color-border-secondary: var(--cocso-color-neutral-800);
  --cocso-color-border-strong: var(--cocso-color-neutral-500);
  --cocso-color-overlay-subtle: var(--cocso-color-white-alpha-5);
  --cocso-color-overlay-muted: var(--cocso-color-white-alpha-10);
  --cocso-color-overlay-strong: var(--cocso-color-white-alpha-20);
  --cocso-color-interactive-primary: var(--cocso-color-primary-50);
  --cocso-color-interactive-primary-hover: var(--cocso-color-primary-200);
  --cocso-color-interactive-primary-active: var(--cocso-color-primary-300);
  --cocso-color-interactive-primary-muted: var(--cocso-color-primary-500);
  --cocso-color-interactive-primary-subtle: var(--cocso-color-primary-900);
  --cocso-color-interactive-primary-text: var(--cocso-color-primary-200);
  --cocso-color-interactive-secondary: var(--cocso-color-neutral-800);
  --cocso-color-interactive-secondary-hover: var(--cocso-color-neutral-700);
  --cocso-color-interactive-neutral: var(--cocso-color-neutral-800);
  --cocso-color-interactive-neutral-hover: var(--cocso-color-neutral-700);
  --cocso-color-interactive-neutral-active: var(--cocso-color-neutral-600);
  --cocso-color-interactive-danger: var(--cocso-color-danger-500);
  --cocso-color-interactive-danger-hover: var(--cocso-color-danger-600);
  --cocso-color-interactive-danger-active: var(--cocso-color-danger-700);
  --cocso-color-interactive-danger-hover-subtle: var(--cocso-color-danger-400);
  --cocso-color-interactive-danger-subtle-hover: var(--cocso-color-danger-950);
  --cocso-color-interactive-danger-subtle-active: var(--cocso-color-danger-900);
  --cocso-color-interactive-success: var(--cocso-color-success-500);
  --cocso-color-interactive-success-hover: var(--cocso-color-success-600);
  --cocso-color-interactive-success-active: var(--cocso-color-success-700);
  --cocso-color-interactive-success-hover-subtle: var(--cocso-color-success-400);
  --cocso-color-interactive-warning: var(--cocso-color-warning-300);
  --cocso-color-interactive-warning-hover: var(--cocso-color-warning-400);
  --cocso-color-interactive-warning-active: var(--cocso-color-warning-500);
  --cocso-color-interactive-warning-hover-subtle: var(--cocso-color-warning-400);
  --cocso-color-interactive-info: var(--cocso-color-info-500);
  --cocso-color-interactive-info-hover: var(--cocso-color-info-600);
  --cocso-color-interactive-info-active: var(--cocso-color-info-700);
  --cocso-color-interactive-info-hover-subtle: var(--cocso-color-info-400);
  --cocso-color-interactive-info-text: var(--cocso-color-info-300);
  --cocso-color-interactive-info-text-hover: var(--cocso-color-info-200);
  --cocso-color-focus-ring: var(--cocso-color-primary-50);
  --cocso-color-feedback-danger: var(--cocso-color-danger-400);
  --cocso-color-feedback-danger-subtle: var(--cocso-color-danger-950);
  --cocso-color-feedback-danger-text: var(--cocso-color-danger-300);
  --cocso-color-feedback-danger-border: var(--cocso-color-danger-800);
  --cocso-color-feedback-success: var(--cocso-color-success-400);
  --cocso-color-feedback-success-subtle: var(--cocso-color-success-950);
  --cocso-color-feedback-success-text: var(--cocso-color-success-300);
  --cocso-color-feedback-success-border: var(--cocso-color-success-800);
  --cocso-color-feedback-success-muted: var(--cocso-color-success-400);
  --cocso-color-feedback-warning: var(--cocso-color-warning-400);
  --cocso-color-feedback-warning-subtle: var(--cocso-color-warning-950);
  --cocso-color-feedback-warning-text: var(--cocso-color-warning-300);
  --cocso-color-feedback-warning-border: var(--cocso-color-warning-800);
  --cocso-color-feedback-info: var(--cocso-color-info-400);
  --cocso-color-feedback-info-subtle: var(--cocso-color-info-950);
  --cocso-color-feedback-info-text: var(--cocso-color-info-300);
  --cocso-color-feedback-info-border: var(--cocso-color-info-800);
}
